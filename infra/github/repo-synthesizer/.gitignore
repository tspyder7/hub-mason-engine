# ==========================================
# OpenTofu & Terraform Core Files
# ==========================================

# Local .terraform / .opentofu working directories
.terraform/
.opentofu/

# Hide local provider plugins and modules downloads
.terraform.plugins/
.opentofu.plugins/
.terraform/modules/
.opentofu/modules/
.terraform/providers/
.opentofu/providers/

# ==========================================
# State Files & Backups (CRITICAL SECURITY)
# ==========================================

# Never commit state files, as they contain sensitive plaintext credentials
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files generated by OpenTofu
crash.log
crash.*.log

# ==========================================
# Input Variables & Sensitive Configurations
# ==========================================

# Ignore variable files that contain real secret values
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exception: Allow example or template variable files for documentation
!example.tfvars
!*.tfvars.example
!*.tfvars.template

# ==========================================
# Generated Execution Plans
# ==========================================

# Plan files often contain sensitive secrets in clear text
*.tfplan
*.tfplan.*
tfplan

# ==========================================
# OpenTofu CLI & Provider Locks
# ==========================================

# CLI configuration files
.terraformrc
terraform.rc
.tofurc

# NOTE: Do NOT ignore `.terraform.lock.hcl` or `.tofu.lock.hcl`.
# Lock files SHOULD be committed to Git to ensure consistent provider versions across teams/CI.

# ==========================================
# OS & Editor Specific Files
# ==========================================

# MacOS
.DS_Store
.AppleDouble
.ls-cache

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs & Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*~
